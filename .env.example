# Skopiuj do .env albo uruchom `npm run setup`, który wygeneruje klucze automatycznie.
# NIGDY nie commituj pliku .env.

NODE_ENV=development

# --- Baza danych (docker compose: port 5433 na localhost) ---
POSTGRES_PASSWORD=alert_dev_haslo
DATABASE_URL=postgresql://alert:alert_dev_haslo@127.0.0.1:5433/alert

# --- Serwer API ---
API_PORT=3000
# 127.0.0.1 = tylko ten komputer; 0.0.0.0 = dostęp z telefonu w tej samej sieci Wi-Fi
API_HOST=127.0.0.1
# Adres, pod którym użytkownik otwiera aplikację (do linków i nazwy w aplikacji 2FA)
APP_URL=http://localhost:5180
APP_NAME=Alert Szkolny

# --- Szyfrowanie danych osobowych (numery telefonów, sekrety 2FA) ---
# Format: <id>:<klucz base64, 32 bajty>. Kilka kluczy oddziel przecinkami (rotacja).
# Nowe dane szyfrowane są kluczem ENCRYPTION_ACTIVE_KEY_ID, stare odczytywane dowolnym z listy.
ENCRYPTION_KEYS=v1:WYGENERUJ_PRZEZ_npm_run_setup
ENCRYPTION_ACTIVE_KEY_ID=v1
# Klucz HMAC do wyszukiwania/deduplikacji numerów bez ich odszyfrowywania (base64, 32 bajty)
BLIND_INDEX_KEY=WYGENERUJ_PRZEZ_npm_run_setup

# --- Sesje i logowanie ---
SESSION_TTL_DAYS=14
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15

# --- Dane startowe (npm run db:seed) ---
# Hasło dla kont demonstracyjnych admin@szkola.test, dyrektor@szkola.test, nauczyciel@szkola.test
SEED_PASSWORD=WYGENERUJ_PRZEZ_npm_run_setup

# --- Bramka SMS ---
# fake = nic nie jest wysyłane (bezpieczne do testów i ćwiczeń)
# smsfly / smsapi / serwersms = prawdziwe SMS-y przez wybraną bramkę
SMS_PROVIDER=fake
# Bramka zapasowa przy awarii głównej: none / smsfly / smsapi / serwersms
SMS_BACKUP_PROVIDER=none
# Klucze z paneli bramek. Nie wklejaj ich nigdzie poza tym plikiem.
# SMS-fly (sms-fly.pl): panel → Integracja / Ustawienia API → wygeneruj klucz API
SMSFLY_API_KEY=
SMSFLY_API_URL=https://sms-fly.pl/api/v2/api.php
# Jak długo operator próbuje doręczyć SMS (minuty, max 1440)
SMSFLY_TTL_MINUTES=240
SMSAPI_TOKEN=
SMSAPI_URL=https://api.smsapi.pl
SERWERSMS_TOKEN=
SERWERSMS_URL=https://api2.serwersms.pl
# true = bez nazwy nadawcy (domyślny nadawca konta) – np. zanim bramka zatwierdzi nazwę szkoły
SMS_USE_DEFAULT_SENDER=false
# Limit zapytań do bramki na sekundę (dopasuj do konta). Paczka wielu numerów to jedno zapytanie.
SMS_RATE_PER_SECOND=10
# Pule: ile numerów z tą samą treścią w jednym zapytaniu (SMSAPI do 10000, SerwerSMS) i ile zapytań naraz
SMS_BATCH_SIZE=500
SMS_CONCURRENCY=10
# Raporty doręczeń: publiczny adres HTTPS aplikacji (po wdrożeniu na serwer). Lokalnie zostaw puste.
SMS_CALLBACK_BASE_URL=
SMS_WEBHOOK_TOKEN=WYGENERUJ_PRZEZ_npm_run_setup
# Tryb fake: jaki odsetek SMS-ów symulować jako niedoręczone (ćwiczenie ścieżki „nie dotarło”)
FAKE_FAILURE_RATE=0.05

# --- Tryb awaryjny (praca bez bazy danych) ---
# Zaszyfrowana kopia kontaktów, kont i sesji oraz dziennik wysyłek bez bazy (względem katalogu apps/api)
EMERGENCY_DATA_DIR=../../.data/emergency
# Co ile minut odświeżać kopię z bazy
SNAPSHOT_INTERVAL_MINUTES=5

# --- RODO ---
# Po ilu dniach od zakończenia alertu usuwać dane osobowe z jego historii
ALERT_RETENTION_DAYS=365
